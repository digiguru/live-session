{
  "name": "@digiguru/live-session",
  "version": "0.1.0",
  "description": "Transport-agnostic collaboration session primitives with optional realtime presence utilities.",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digiguru/live-session.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presence": {
      "types": "./dist/presence.d.ts",
      "import": "./dist/presence.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "author": "Adam Hall (@digiguru)",
  "license": "MIT",
  "keywords": [
    "collaboration",
    "realtime",
    "session",
    "presence",
    "workshop",
    "websocket",
    "typescript"
  ],
  "homepage": "https://github.com/digiguru/live-session#readme",
  "bugs": {
    "url": "https://github.com/digiguru/live-session/issues"
  }
}
